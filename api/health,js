export default function handler(req, res) {
  // Set CORS headers to allow your Vercel frontend domain
  res.setHeader('Access-Control-Allow-Origin', 'https://your-vercel-frontend-url.vercel.app');
  res.setHeader('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE'); // Allow these HTTP methods
  res.setHeader('Access-Control-Allow-Headers', 'Content-Type, Authorization'); // Allow headers like Content-Type, Authorization

  // Handle preflight request (OPTIONS request)
  if (req.method === 'OPTIONS') {
    return res.status(200).end(); // Respond with 200 OK for preflight requests
  }

  // Your regular API logic goes here
  if (req.method === 'GET') {
    res.status(200).json({ message: 'Success' });
  } else {
    res.status(405).json({ error: 'Method Not Allowed' });
  }
}
